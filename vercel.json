{
  "rewrites": [
    { "source": "/goroblacyconsultationconfirmed", "destination": "/index.html" }
  ],
  "functions": {
    "api/chat.js": { "includeFiles": "index.html", "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
